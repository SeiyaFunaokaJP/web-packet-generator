# Pinned versions of the build tools that rustup does not install (rust-toolchain.toml pins
# the Rust toolchain and the wasm32 target). Read by scripts/setup.sh, scripts/setup.ps1,
# scripts/lib/remote-build.sh, the Dockerfile and .github/workflows/ci.yml.
# Format: KEY=value, no quotes or spaces (sourced by sh, parsed by PowerShell).

# Trunk, the web UI bundler: https://github.com/trunk-rs/trunk/releases
TRUNK_VERSION=0.21.14

# Npcap SDK (Windows): wpcap.lib for linking the pcap backend. https://npcap.com/#download
# scripts/release.sh carries its own copy of these two values; change both together.
NPCAP_SDK_VERSION=1.15
NPCAP_SDK_SHA256=52c7b9fb4abee3ad9fe739bb545c3efe77b731c8e127122bdf328eafdae3ed4f
