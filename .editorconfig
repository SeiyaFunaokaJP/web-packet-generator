root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,html,css,js,ts}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf

[{justfile,Makefile}]
indent_style = tab

# Windows PowerShell 5.1 reads a script without a BOM in the ANSI code page, which breaks
# the Japanese prompts of the deploy wizard.
[scripts/deploy.ps1]
charset = utf-8-bom
